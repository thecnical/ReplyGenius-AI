# ===========================================
# ReplyGenius AI Backend - Environment Setup
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:*

# JWT Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Encryption Key (for user API keys)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-256-bit-encryption-key-hex

# ===========================================
# Database Configuration
# ===========================================

# MongoDB (Production) - Get from MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/replygenius
MONGODB_URI=mongodb://localhost:27017/replygenius

# Set to 'true' for development without MongoDB
USE_MEMORY_DB=false

# Redis (Optional - for distributed caching)
# Format: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ===========================================
# AI Provider API Keys
# ===========================================

# OpenRouter (Primary Provider)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bytez AI (Fallback Provider)
# Get your key from: https://bytez.com/dashboard
BYTEZ_API_KEY=bz_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Rate Limiting
# ===========================================

# Free tier: requests per day
RATE_LIMIT_FREE=20

# Premium tier: requests per day
RATE_LIMIT_PREMIUM=1000

# ===========================================
# Circuit Breaker Configuration
# ===========================================

# Number of failures before opening circuit
CIRCUIT_BREAKER_THRESHOLD=5

# Time in ms to wait before trying again
CIRCUIT_BREAKER_TIMEOUT=60000

# ===========================================
# Analytics & Optimization
# ===========================================

# Latency threshold in ms for auto-routing
ANALYTICS_LATENCY_THRESHOLD=3000

# Number of failures before triggering optimization
ANALYTICS_FAILURE_THRESHOLD=3
